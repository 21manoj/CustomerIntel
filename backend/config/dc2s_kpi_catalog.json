  "pillar_roles": {
    "adoption": "P1",
    "reliability": "P2",
    "capacity": "P3",
    "partner": "P4",
    "expansion": "P5"
  },
  "pillar_roles_notes": {
    "P3": "AI Workload Performance ('GPU utilization and AI workload execution efficiency') maps to 'capacity' rather than 'adoption' -- it measures utilization of provisioned resources, the same concept datacenter_v1's Fleet Utilization & Goodput (P2) plays as 'capacity', not usage/onboarding."
  },
  "kpis": {
    "P1-KPI1": {
      "name": "Time-to-First-Workload",
      "pillar": "P1",
      "weight_l1": 0.2,
      "frequency": "monthly",
      "unit": "days",
      "higher_is_better": false,
      "target": {
        "operator": "<",
        "value": 14
      },
      "ranges": {
        "healthy": {
          "min": 0,
          "max": 14,
          "color": "green"
        },
        "risk": {
          "min": 14,
          "max": 21,
          "color": "yellow"
        },
        "critical": {
          "min": 21,
          "max": 60,
          "color": "red"
        }
      },
      "description": "Days from hardware arrival to first AI workload running in production",
      "impact": "high",
      "correlation": 0.45,
      "saas_kpi_code": "TTFV",
      "saas_category": "Product Usage & Onboarding",
      "data_source": "deployment_tracking",
      "calculation": "DATE(first_workload_completion) - DATE(hardware_delivery)"
