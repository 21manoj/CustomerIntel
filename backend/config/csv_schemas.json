        ],
        "db_table": "context_nodes (node_type=ACCOUNT) + accounts (profile_metadata JSON)",
        "note": "Merged with old profiles.csv \u2014 CSM/champion fields are now optional columns here."
      },
      "outcomes.csv": {
        "required_columns": [
          "source_account_id",
          "outcome_date",
          "title",
          "outcome_type",
          "revenue_value"
        ],
        "optional_columns": [
          "outcome_id",
          "evidence",
          "confidence",
          "related_decision_id",
          "source_platform"
        ],
        "enums": {
          "outcome_type": {
            "_description": "Comprehensive outcome taxonomy grouped by revenue direction.",
            "protected": [
              "renewal_secured",
              "renewal_confirmed",
              "churn_averted",
              "revenue_protected",
              "escalation_resolved"
            ],
            "growth": [
              "expansion_closed",
              "expansion_approved",
              "expansion_opportunity",
              "revenue_growth",
              "new_logo"
            ],
            "at_risk": [
              "revenue_at_risk",
              "renewal_uncertainty",
              "renewal_risk",
              "engagement_decline",
              "capacity_constraint",
              "partner_friction"
            ],
            "lost": [
              "churn_lost",
              "contraction"
            ],
            "operational": [
              "playbook_outcome",
              "partial_recovery",
              "recovery_milestone"
            ]
          }
        },
        "db_table": "context_nodes (node_type=OUTCOME)",
        "note": "8 outcome_type values for Beta. revenue_value is the dollar impact (positive for growth, negative for loss)."
      }
    },
    "auto_generated": {
      "_description": "These 2 files are derived by the platform during process-data. If a customer uploads them, the upload is accepted and auto-generation is skipped.",
      "decisions.csv": {
        "required_columns": [
