{
  "_description": "Single source of truth for CSV column definitions. Both backend generate_synthetic_customer_data.py and load-driver csv_generator.py MUST use these exact column names. The onboarding API (onboarding_api_v2_config_aware.py) validates against these.",
  "_version": "2.0",
  "_updated": "2026-03-15",
  "_consolidation_note": "Consolidated from 15 to 11 files. Primary onboarding: account_details.csv (enriched) + kpi_measurements.csv. Context graph CSVs optional. accounts.csv accepted as backward-compat alias for account_details.csv.",
  "regular_model": {
    "_description": "2 primary CSVs for onboarding. account_details.csv consolidates accounts + products + stakeholder metadata + business profiles into one file.",
    "files": {
      "account_details.csv": {
        "required_columns": [
          "source_account_id",
          "account_name",
          "industry",
          "region",
          "arr"
        ],
        "recommended_columns": [
          "csm_name",
          "csm_email",
          "csm_manager",
          "primary_champion_name",
          "primary_champion_title",
          "primary_champion_email",
          "executive_sponsor",
          "products",
          "contract_start",
          "contract_end",
          "renewal_date",
          "account_status",
          "tier"
        ],
        "optional_columns": [
          "customer_id",
          "vertical",
          "primary_champion_engagement_score",
          "employee_count",
          "tech_stack",
          "cloud_provider",
          "deployment_type",
          "competitive_landscape",
          "strategic_initiatives",
          "budget_cycle",
          "fiscal_year_end",
          "revenue",
          "uuid"
        ],
        "db_table": "accounts + products + context_nodes(STAKEHOLDER)",
        "note": "Enriched account file. 'products' is a JSON array: [{\"name\": \"...\", \"arr\": 1000000, \"adoption\": null}]. adoption is auto-populated by process_data from P1 pillar score. 'account_status' values: active|onboarding|at_risk|churned|paused. Supersedes accounts.csv + products.csv + account_business_profiles.csv."
      },
      "accounts.csv": {
        "_deprecated": true,
        "required_columns": [
          "source_account_id",
          "customer_id",
          "account_name",
          "industry",
          "region",
          "arr",
          "renewal_date"
        ],
        "recommended_columns": [
          "csm_name",
          "contract_start",
          "contract_end",
          "account_status"
        ],
        "optional_columns": [
          "vertical",
          "tier",
          "revenue",
          "csm_email",
          "uuid"
        ],
        "db_table": "accounts",
        "note": "arr and renewal_date are required — ROI engine, NRR forecast, and Power-of-1 depend on them."
      },
      "kpi_measurements.csv": {
        "required_columns": [
          "source_account_id",
          "kpi_code",
          "measured_at",
          "value"
        ],
        "optional_columns": [
          "kpi_name",
          "pillar",
          "target",
          "weight",
          "unit",
          "status"
        ],
        "db_table": "dc2s_kpis",
        "note": "NEVER use kpi_data.csv \u2014 always kpi_measurements.csv"
      },
      "enhanced_qualitative_signals.csv": {
        "required_columns": [
          "source_account_id",
          "signal_date",
          "signal_type",
          "content",
          "sentiment"
        ],
        "optional_columns": [
          "signal_ref",
          "sentiment_score",
          "stakeholder_name",
          "stakeholder_title",
          "causal_chain_ref",
          "revenue_impact",
          "confidence",
          "source_platform"
        ],
        "enums": {
          "signal_type": {
            "_description": "Comprehensive signal taxonomy. Grouped by category for onboarding guidance.",
            "risk_negative": [
              "kpi_decline",
              "critical_incident",
              "champion_departure",
              "champion_loss",
              "engagement_gap",
              "engagement_decline",
              "engagement_drop",
              "usage_decline",
              "competitor_mention",
              "competitor_evaluation",
              "budget_pressure",
              "budget_review",
              "budget_change",
              "escalation",
              "escalation_increase",
              "support_escalation",
              "support_spike",
              "deployment_delay",
              "onboarding_delay",
              "contract_dispute",
              "renewal_risk",
              "csat_drop",
              "nps_decline",
              "login_decline",
              "feature_adoption_drop",
              "ttfv_exceeded",
              "stakeholder_escalation",
              "stakeholder_change",
              "org_change",
              "downsizing",
              "expansion_cancelled",
              "expansion_stall",
              "kpi_breach",
              "capacity_warning",
              "incident"
            ],
            "positive_growth": [
              "expansion_signal",
              "expansion_discussion",
              "expansion_completed",
              "advocacy",
              "champion_advocacy",
              "executive_engagement",
              "health_improvement",
              "positive_engagement",
              "champion_reengagement",
              "kpi_recovery",
              "deployment_improvement",
              "churn_averted",
              "feature_adoption",
              "feature_adoption_increase",
              "usage_spike",
              "nps_increase",
              "rapid_adoption",
              "fast_onboarding",
              "recovery_milestone",
              "onboarding_milestone"
            ],
            "operational": [
              "csm_intervention",
              "csm_action",
              "routine_review",
              "seasonal_pattern",
              "sla_started",
              "playbook_executed",
              "health_score_alert",
              "support_ticket"
            ]
          },
          "sentiment": ["positive", "negative", "neutral"]
        },
        "db_table": "qualitative_signals + context_nodes (node_type=SIGNAL)",
        "note": "Comprehensive signal taxonomy (64 types in 3 categories). sentiment is required (positive/negative/neutral). Graph metadata columns (signal_ref, causal_chain_ref) are optional."
      },
      "products.csv": {
        "required_columns": [
          "source_account_id",
          "product_name"
        ],
        "optional_columns": [
          "product_category",
          "quantity",
          "unit_price",
          "deployment_date",
          "status",
          "customer_id"
        ],
        "db_table": "products"
      }
    }
  },
  "context_graph_model": {
    "_description": "7 CSVs for context graph mode. 4 customer-provided + 3 auto-generated by platform.",
