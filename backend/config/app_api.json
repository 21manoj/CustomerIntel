{
  "_doc": "The human UI's session auth — every number the app_api/ package uses. Separate from config/signal_engine.json etc. by concern, same loader shape.",
  "version": "1.0",
  "roles": ["admin", "cro", "cfo", "csm", "vpcsm"],
  "session": {
    "cookie_name": "ci_session",
    "max_age_seconds": 43200,
    "secret_env": "SESSION_SECRET"
  },
  "password_setup": {
    "token_bytes": 32,
    "expiry_minutes": 15
  },
  "login_rate_limit": {
    "max_failures": 5,
    "window_seconds": 300,
    "block_seconds": 60,
    "cleanup_interval_seconds": 600
  },
  "password_min_length": 10,
  "platform": {
    "_doc": "The platform console (platform_admin/). Roles a user may hold in users.platform_role, and the thresholds behind the attention list.",
    "roles": ["operator", "viewer"],
    "write_roles": ["operator"],
    "attention": {
      "stale_data_days": 14,
      "denied_calls_window_hours": 24,
      "denied_calls_threshold": 20,
      "tenant_expiry_warning_days": 7,
      "key_expiry_warning_days": 14,
      "process_run_stuck_minutes": 30
    },
    "alerts": {
      "_doc": "platform_admin/alerts.py. The topic itself comes from the ALERT_SNS_TOPIC_ARN environment variable.",
      "alarm_name_prefix": "customerintel",
      "history_limit": 20,
      "host_log_path": "/var/log/customerintel/alert.log",
      "host_log_lines": 400,
      "aws_timeout_seconds": 4
    },
    "audit_page_size": 100,
    "audit_max_page_size": 500
  }
}
