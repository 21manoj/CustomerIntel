{
  "version": "1.0",
  "vertical": "tprm_v1",
  "description": "Third-party risk management for a bank: six pillars (Security, Operational resilience, Risk exposure, Compliance, Performance, Governance), 33 KPIs. The 12 marked core are the minimum set; a KPI with no measurement is left out of the score and the remaining weights are rescaled, so a vendor can be scored on the core set alone.",
  "pillars": {
    "S": {
      "name": "Security & Data Protection",
      "weight_l2": 0.22,
      "kpi_count": 6
    },
    "O": {
      "name": "Operational Resilience",
      "weight_l2": 0.2,
      "kpi_count": 6
    },
    "R": {
      "name": "Risk Exposure",
      "weight_l2": 0.18,
      "kpi_count": 5
    },
    "C": {
      "name": "Compliance & Assurance",
      "weight_l2": 0.18,
      "kpi_count": 5
    },
    "P": {
      "name": "Performance & Service Delivery",
      "weight_l2": 0.12,
      "kpi_count": 6
    },
    "G": {
      "name": "Governance & Oversight",
      "weight_l2": 0.1,
      "kpi_count": 5
    }
  },
  "pillar_roles": {
    "compliance": "C",
    "reliability": "O"
  },
  "pillar_roles_notes": {
    "S,R,P,G": "Security, Risk exposure, Performance and Governance have no matching role in the shared vocabulary; left unmapped rather than forced."
  },
