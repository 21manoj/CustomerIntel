{
  "version": "1.0",
  "vertical": "datacenter_v1",
  "description": "GPU-rental neocloud (DataCenterV1) \u2014 rent NVIDIA GPUs hourly / reserved clusters. Health optimized for realized revenue x utilization x goodput x sellable power. See docs/GPU_NEOCLOUD_VERTICAL_SPEC.md.",
  "pillars": {
    "P1": {
      "name": "Revenue & Unit Economics",
      "weight_l2": 0.25,
      "kpi_count": 6,
      "semantic_code": "R1"
    },
    "P2": {
      "name": "Fleet Utilization & Goodput",
      "weight_l2": 0.22,
      "kpi_count": 7,
      "semantic_code": "R2"
    },
    "P3": {
      "name": "Reliability & SLA Delivery",
      "weight_l2": 0.2,
      "kpi_count": 8,
      "semantic_code": "R3"
    },
    "P4": {
      "name": "Power & Facility",
      "weight_l2": 0.13,
      "kpi_count": 6,
      "semantic_code": "R4"
    },
    "P5": {
      "name": "Commercial & Expansion",
      "weight_l2": 0.15,
      "kpi_count": 8,
      "semantic_code": "R5"
    },
    "P6": {
      "name": "Provisioning Velocity",
      "weight_l2": 0.05,
      "kpi_count": 3,
      "semantic_code": "R6"
    }
  },
  "pillar_roles": {
    "revenue": "P1",
    "capacity": "P2",
    "reliability": "P3",
    "expansion": "P5",
    "adoption": "P6"
  },
  "pillar_roles_notes": {
    "P4": "Power & Facility has no matching role in the shared vocabulary -- explicitly NOT 'partner' (confirmed by the partner_portal gate this phase retrofits: this pillar is facility/power infrastructure, not a channel/partner relationship) and not 'compliance' either. Left unmapped.",
    "P6": "Provisioning Velocity mapped to 'adoption' by analogy with dc2_s's P1 Deployment Velocity (also 'adoption') -- both measure time-to-first-value/onboarding speed (Power-of-1 maps P6 to the TTFV metric_id). Moderate-confidence call: 'velocity' isn't literally 'adoption', flagged for review."
  },
