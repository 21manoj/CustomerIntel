{
  "version": "1.0",
  "vertical": "datacenter_v1",
  "playbooks": [
    {
      "id": "incident_escalation",
      "label": "Infrastructure incident — engineering escalation",
      "trigger": {"roles": ["infra_incident"], "urgency_floor": "high"},
      "action_class": "escalate",
      "approval": "human",
      "expected_outcome": {"types": ["escalation_resolved", "revenue_protected", "churn_lost"], "window_days": 60}
    },
    {
      "id": "capacity_expansion_offer",
      "label": "Capacity pressure — expansion offer",
      "trigger": {"roles": ["capacity_pressure", "expansion_intent"], "urgency_floor": "medium"},
      "action_class": "offer",
      "approval": "human",
      "expected_outcome": {"types": ["expansion_closed", "expansion_opportunity", "repeat_order"], "window_days": 120}
    },
    {
      "id": "commercial_pressure_save",
      "label": "Commercial pressure — renewal save",
      "trigger": {"roles": ["commercial_pressure"], "urgency_floor": "high", "renewal_within_days": 180},
      "action_class": "schedule",
      "approval": "human",
      "expected_outcome": {"types": ["renewal_secured", "revenue_protected", "contraction", "churn_lost"], "window_days": 120}
    },
    {
      "id": "expansion_intent_handoff",
      "label": "Expansion intent — sales handoff",
      "trigger": {"roles": ["expansion_intent"], "urgency_floor": "medium"},
      "action_class": "notify",
      "approval": "auto",
      "expected_outcome": {"types": ["expansion_closed", "expansion_opportunity"], "window_days": 90}
    }
  ]
}
