        "roles": [
          "capacity_pressure",
          "expansion_intent"
        ],
        "urgency_floor": "medium"
      },
      "action_class": "offer",
      "approval": "human",
      "expected_outcome": {
        "types": [
          "expansion_closed",
          "expansion_opportunity",
          "repeat_order"
        ],
        "window_days": 120
      }
    },
    {
      "id": "refresh_at_risk_save",
      "label": "Commercial pressure: refresh save",
      "trigger": {
        "roles": [
          "commercial_pressure"
        ],
        "urgency_floor": "high",
