      "label": "Infrastructure incident: engineering escalation",
      "trigger": {
        "roles": [
          "infra_incident"
        ],
        "urgency_floor": "high"
      },
      "action_class": "escalate",
      "approval": "human",
      "expected_outcome": {
        "types": [
          "escalation_resolved",
          "revenue_protected",
          "churn_lost"
        ],
        "window_days": 60
      }
    },
    {
