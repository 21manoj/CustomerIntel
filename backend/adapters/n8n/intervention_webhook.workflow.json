      ]
    },
    "Respond 200": {
      "main": [[{ "node": "Wait for the platform to commit sent", "type": "main", "index": 0 }]]
    },
    "Wait for the platform to commit sent": {
      "main": [[{ "node": "report_intervention started", "type": "main", "index": 0 }]]
    },
    "report_intervention started": {
      "main": [[{ "node": "Do the work (replace with your steps)", "type": "main", "index": 0 }]]
    },
    "Do the work (replace with your steps)": {
      "main": [[{ "node": "report_intervention done", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
