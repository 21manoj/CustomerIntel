# Copy to deploy/.env (git-ignored) and fill in.
POSTGRES_PASSWORD=change-me-48-hex
MCP_SERVER_API_KEY=change-me-48-hex
SESSION_SECRET=change-me-48-hex
MCP_AUTH_REQUIRED=true
LOG_LEVEL=INFO
# Caddy topology — see docker-compose.customerintelv1.yml for the full explanation.
#   shared (default, leave unset): an existing Caddy elsewhere on this box fronts the app.
#   standalone: this compose project runs its own Caddy; nothing else on the box required.
#DEPLOY_MODE=standalone
# standalone only — the public hostname Caddy gets a cert for. Leave unset to have
# deploy_ec2.sh derive it from this box's own public IP via the EC2 metadata service.
#CADDY_SITE=
# Signal engine extraction (free text). Empty = keyword stub, flagged requires_review.
ANTHROPIC_API_KEY=
# Optional: overrides llm.model in config/signal_engine.json
SIGNAL_ENRICHMENT_MODEL=
SIGNAL_WORKER=true
# Backend scaling plan step 1 — Postgres max_connections and the app's SQLAlchemy
# pool sizing. Defaults (shown) are safe to leave unset; tune only if you're running
# multiple app instances or see pool_timeout errors under load. Keep
# N_web * (DB_POOL_SIZE + DB_MAX_OVERFLOW) + the signal worker + deploy-script
# connections comfortably under POSTGRES_MAX_CONNECTIONS.
#POSTGRES_MAX_CONNECTIONS=200
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=5
#DB_POOL_PRE_PING=true
#DB_POOL_RECYCLE=1800
# Set by deploy_ec2.sh:
GIT_SHA=
BUILD_TIME=
