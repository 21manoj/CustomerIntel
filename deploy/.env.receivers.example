# Copy to deploy/.env.receivers on the box and fill in. Never commit the filled-in file.
#
# CI_RECEIVER_SECRET_{10,11}: shared HMAC secret for that tenant's webhook (openssl rand -hex 24).
#   The SAME value must be passed to configure_playbooks(customer_id, webhook_secret=...) for that tenant.
# CI_PLATFORM_KEY_{10,11}: a customer-scoped API key (scopes=['read','write']) for that tenant —
#   the receiver uses it to call POST /api/interventions/{id}/report. Minted via
#   api_key_service.generate_api_key(); shown once, so keep this file's permissions tight (chmod 600).
CI_RECEIVER_SECRET_10=
CI_PLATFORM_KEY_10=

CI_RECEIVER_SECRET_11=
CI_PLATFORM_KEY_11=

# Optional override; defaults to the live CustomerIntelV1 hostname in the compose file.
# CI_PLATFORM_URL=https://customerintelv1.3-218-251-181.sslip.io
